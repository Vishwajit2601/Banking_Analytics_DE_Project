		{
			"name": "[concat(parameters('workspaceName'), '/Business_Query')]",
			"type": "Microsoft.Synapse/workspaces/sqlscripts",
			"apiVersion": "2019-06-01-preview",
			"properties": {
				"content": {
					"query": "USE banking_analytics_db;\n\n-- Top customers by balance\nSELECT TOP 20\n    customer_id,\n    full_name,\n    city,\n    state,\n    total_balance,\n    total_loan_amount,\n    total_card_outstanding,\n    risk_score\nFROM gold.vw_customer_360\nORDER BY total_balance DESC;\n\n-- Fraud analysis\nSELECT\n    fraud_year,\n    fraud_month,\n    fraud_type,\n    risk_level,\n    fraud_count,\n    total_loss,\n    confirmed_frauds,\n    confirmation_rate\nFROM gold.vw_fraud_analysis\nORDER BY total_loss DESC;\n\n\n-- Monthly financial performance\nSELECT\n    transaction_year,\n    transaction_month,\n    total_transactions,\n    total_credits,\n    total_debits,\n    net_flow,\n    upi_volume,\n    netbanking_volume,\n    rtgs_volume,\n    imps_volume\nFROM gold.vw_monthly_financial\nORDER BY\n    transaction_year,\n    transaction_month;\n\n\n\n\n\n\n\n\n\n\n",
					"metadata": {
						"language": "sql"
					},
					"currentConnection": {
						"databaseName": "banking_analytics_db",
						"poolName": "Built-in"
					},
					"resultLimit": 5000
				},
				"type": "SqlQuery"
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('workspaceName'), '/Check_records_count')]",
			"type": "Microsoft.Synapse/workspaces/sqlscripts",
			"apiVersion": "2019-06-01-preview",
			"properties": {
				"content": {
					"query": "USE banking_analytics_db;\n\nSELECT COUNT(*) AS customer_360_count\nFROM gold.vw_customer_360;\n1000\n\nSELECT COUNT(*) AS fraud_analysis_count\nFROM gold.vw_fraud_analysis;\n-- 362\n\nSELECT COUNT(*) AS monthly_financial_count\nFROM gold.vw_monthly_financial;\n-- 29",
					"metadata": {
						"language": "sql"
					},
					"currentConnection": {
						"databaseName": "banking_analytics_db",
						"poolName": "Built-in"
					},
					"resultLimit": 5000
				},
				"type": "SqlQuery"
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('workspaceName'), '/SQL script 1')]",
			"type": "Microsoft.Synapse/workspaces/sqlscripts",
			"apiVersion": "2019-06-01-preview",
			"properties": {
				"content": {
					"query": "CREATE DATABASE banking_analytics_db;\n\nUSE banking_analytics_db;\n\nSELECT DB_NAME() AS current_database;\n\nCREATE SCHEMA gold;\n\nCREATE VIEW gold.vw_customer_360\nAS\nSELECT *\nFROM OPENROWSET(\n    BULK 'https://adlsbankinganalytics.dfs.core.windows.net/gold/customer_360',\n    FORMAT = 'DELTA'\n) AS customer_data;\n\n\nCREATE VIEW gold.vw_fraud_analysis\nAS\nSELECT *\nFROM OPENROWSET(\n    BULK 'https://adlsbankinganalytics.dfs.core.windows.net/gold/fraud_analysis',\n    FORMAT = 'DELTA'\n) AS fraud_data;\n\n\nCREATE VIEW gold.vw_monthly_financial\nAS\nSELECT *\nFROM OPENROWSET(\n    BULK 'https://adlsbankinganalytics.dfs.core.windows.net/gold/monthly_financial_summary',\n    FORMAT = 'DELTA'\n) AS financial_data;\n\n\n\nSELECT *\nFROM gold.vw_customer_360;\n\nSELECT *\nFROM gold.vw_fraud_analysis;\n\nSELECT *\nFROM gold.vw_monthly_financial;\n\n\n\n\n",
					"metadata": {
						"language": "sql"
					},
					"currentConnection": {
						"databaseName": "banking_analytics_db",
						"poolName": "Built-in"
					},
					"resultLimit": 5000
				},
				"type": "SqlQuery"
			},
			"dependsOn": []
		},
